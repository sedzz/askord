HTTP_ADDR=:8080
DATABASE_URL=postgres://askord:askord@localhost:5432/askord?sslmode=disable

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=

DISCORD_REDIRECT_URL=http://localhost:8080/auth/callback

# Frontend (Vite) URL to return to after login
FRONTEND_URL=http://localhost:5173

# true in production (HTTPS)
COOKIE_SECURE=false

# Key used to encrypt the LLM API keys that server admins connect (32 bytes, base64):
#   openssl rand -base64 32
# Without it, the AI feature stays disabled. If you lose or change it, the API keys have to be
# entered again.
AI_ENCRYPTION_KEY=

# Development only: allows the LLM URL to be local or private (e.g. Ollama).
AI_ALLOW_PRIVATE_URLS=false
