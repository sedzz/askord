HTTP_ADDR=:8080
DATABASE_URL=postgres://askord:askord@localhost:5432/askord?sslmode=disable

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=

DISCORD_REDIRECT_URL=http://localhost:8080/auth/callback

# URL del frontend (Vite) a la que se vuelve tras el login
FRONTEND_URL=http://localhost:5173

# true en produccion (HTTPS)
COOKIE_SECURE=false

# Clave para cifrar las API keys de los LLM que conectan los admins (32 bytes en base64):
#   openssl rand -base64 32
# Sin ella, la función de IA queda desactivada. Si la pierdes o la cambias, hay que volver a
# introducir las API keys.
AI_ENCRYPTION_KEY=

# Solo desarrollo: permite que la URL del LLM sea local o privada (p. ej. Ollama).
AI_ALLOW_PRIVATE_URLS=false
