# Se copia al servidor como .env (junto a docker-compose.prod.yml, guardado como docker-compose.yml).
# Nunca se sube a Git.

# openssl rand -base64 24
POSTGRES_PASSWORD=

# Cloudflare Zero Trust > Networks > Tunnels > tu túnel > token
TUNNEL_TOKEN=

# Discord Developer Portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# El dominio público que publica el túnel (HTTPS). Tiene que estar también
# registrado como Redirect en Discord > OAuth2.
DISCORD_REDIRECT_URL=https://tu-dominio.example/auth/callback
FRONTEND_URL=https://tu-dominio.example

# openssl rand -base64 32  (sin ella, el asistente de IA queda desactivado)
AI_ENCRYPTION_KEY=
